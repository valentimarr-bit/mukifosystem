/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/qrcode.js
  Cache-Control: public, max-age=86400
/fotos.js
  Cache-Control: public, max-age=300
/tema.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/entrar.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/planilhas.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/financeiro.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/cadastros.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/vendor/*
  Cache-Control: public, max-age=604800
/icone*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
/espera.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/ordenar.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/chave.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
