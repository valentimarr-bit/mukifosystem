{
  "name": "mukifo",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema do bar Mukifo: estoque por ficha técnica, compras, POS e pedidos pelo celular",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:criar": "wrangler d1 create mukifo",
    "db:migrar:local": "wrangler d1 migrations apply mukifo --local",
    "db:migrar": "wrangler d1 migrations apply mukifo --remote",
    "test": "node --test 'test/*.test.js'",
    "seed:gerar": "python3 -I scripts/extrair_planilha.py && node scripts/gerar_seed.mjs && node scripts/embutir_sql.mjs",
    "sql:embutir": "node scripts/embutir_sql.mjs",
    "manual": "node scripts/gerar_manual.mjs",
    "gabarito": "python3 -I scripts/gerar_gabarito.py",
    "seed:local": "wrangler d1 execute mukifo --local --file seed/seed.sql",
    "seed": "wrangler d1 execute mukifo --remote --file seed/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
