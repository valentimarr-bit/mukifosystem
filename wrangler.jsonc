{
  // Configuração do Cloudflare Workers para o sistema do Mukifo.
  // Documentação: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mukifosystem",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Todo minuto: busca pedidos do iFood/99Food (só faz algo se o canal estiver ligado em /canais.html).
  "triggers": { "crons": ["* * * * *"] },

  // Páginas estáticas (painel, app de pedidos, tela da fila) ficam em /public.
  // Tudo que não for arquivo estático (ex.: /api/...) cai no Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Banco D1. Sem database_id, o deploy (inclusive o automático pelo GitHub) cria o banco "mukifo"
  // sozinho; as tabelas e os dados da planilha entram no primeiro acesso (src/banco/preparar.js).
  "d1_databases": [
    { "binding": "DB", "database_name": "mukifo" }
  ]
}
